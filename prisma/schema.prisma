// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  version  = "6.19"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum ReservationStatus {
  Confirmed
  Pending
  Cancelled
}

enum CourtStatus {
  Available
  Occupied
  Maintenance
}

enum CoverType {
  Open
  Closed
}

enum CustomerType {
  Monthly
  Casual
}

enum PlayerLevel {
  Beginner
  Intermediate
  Advanced
  Pro
}

enum UserRole {
  Administrator
  Manager
  Reception
}

// ---------- Models ----------
model Arena {
  id          String          @id @default(uuid())
  name        String
  taxId       String
  email       String
  phone       String
  address     String
  settings    ArenaSettings?
  users       User[]
  courts      Court[]
  customers   Customer[]
  reservations Reservation[]
  teamMembers TeamMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ArenaSettings {
  id                String          @id @default(uuid())
  arena             Arena           @relation(fields: [arenaId], references: [id])
  arenaId           String          @unique
  reservationReminder Boolean      @default(true)
  paymentConfirmation Boolean      @default(true)
  cancellationAlert   Boolean      @default(true)
  marketingCampaigns  Boolean      @default(false)
  pix                Boolean      @default(true)
  creditCard         Boolean      @default(true)
  debitCard          Boolean      @default(true)
  cash               Boolean      @default(true)
  bankTransfer       Boolean      @default(true)
  operatingHours     OperatingHour[]
}

model OperatingHour {
  id          String   @id @default(uuid())
  settings    ArenaSettings @relation(fields: [settingsId], references: [id])
  settingsId  String
  day         String
  enabled     Boolean
  open        String
  close       String
}

model User {
  id          String   @id @default(uuid())
  arena       Arena    @relation(fields: [arenaId], references: [id])
  arenaId     String
  name        String
  email       String   @unique
  password    String
  role        UserRole
  status      String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Court {
  id            String   @id @default(uuid())
  arena         Arena    @relation(fields: [arenaId], references: [id])
  arenaId       String
  name          String
  sport         String
  coverType     CoverType @default(Open)
  address       String?
  zipCode       String?
  city          String?
  number        String?
  pricePerHour  Decimal
  status        CourtStatus @default(Available)
  maintenanceStart DateTime?
  maintenanceEnd DateTime?
  features      String[]
  reservations  Reservation[]
}

model Customer {
  id                String       @id @default(uuid())
  arena             Arena        @relation(fields: [arenaId], references: [id])
  arenaId           String
  name              String
  email             String       @unique
  phone             String
  type              CustomerType @default(Casual)
  status            String       @default("Active")
  favoriteSport     String?
  level             PlayerLevel? @default(Beginner)
  totalSpent        Decimal      @default(0)
  reservationsCount Int          @default(0)
  notes             String?
  reservations      Reservation[]
  history           ReservationHistory[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
}

model Reservation {
  id          String   @id @default(uuid())
  arena       Arena    @relation(fields: [arenaId], references: [id])
  arenaId     String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  court       Court    @relation(fields: [courtId], references: [id])
  courtId     String
  sport       String
  date        DateTime
  startTime   String
  endTime     String
  amount      Decimal
  status      ReservationStatus
  isOpen      Boolean      @default(false)
  consumption ConsumptionItem[]
  notes       String?
}

model ConsumptionItem {
  id            String      @id @default(uuid())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  description   String
  quantity      Int
  price         Decimal
  createdAt     DateTime    @default(now())
}

model ReservationHistory {
  id          String   @id @default(uuid())
  arenaId     String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  courtId     String
  courtName   String
  sport       String
  date        DateTime
  startTime   String
  endTime     String
  amount      Decimal
  status      ReservationStatus
  notes       String?
  archivedAt  DateTime @default(now())
}

model TeamMember {
  id      String   @id @default(uuid())
  arena   Arena    @relation(fields: [arenaId], references: [id])
  arenaId String
  name    String
  email   String   @unique
  role    UserRole
  status  String
}
